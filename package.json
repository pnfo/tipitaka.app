{
  "name": "tipitaka.app",
  "version": "3.0.2",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --config web/vite.config.ts",
    "upstream": "tsx build/upstream.ts",
    "build:data": "tsx build/cli.ts",
    "build:fixture": "tsx build/cli.ts --fixture",
    "build:dict": "tsx build/dict-cli.ts",
    "build:dict:fixture": "tsx build/dict-cli.ts --fixture",
    "align:ai": "tsx scripts/align-ai.ts",
    "align:eval": "tsx scripts/align-eval.ts",
    "names:gazetteer": "tsx scripts/names-gazetteer.ts",
    "names:eval": "tsx scripts/names-eval.ts",
    "names:geo": "tsx scripts/names-geo.ts",
    "names:ai": "tsx scripts/names-ai.ts",
    "dict:ai": "tsx scripts/dict-ai.ts",
    "ref-check": "tsx scripts/ref-check.ts",
    "converter-check": "tsx scripts/converter-check.ts",
    "build:web": "vite build --config web/vite.config.ts",
    "build:web:app": "VITE_APP=1 vite build --config web/vite.config.ts",
    "build:server": "bash scripts/build-server.sh",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "lint": "eslint shared build web/src e2e",
    "test": "vitest run",
    "test:full": "FULL=1 vitest run build",
    "test:go": "cd server && go test ./...",
    "test:e2e": "npm run build:fixture && npm run build:dict:fixture && npm run build:web && npm run build:web:app && npm run build:server && playwright test -c e2e/playwright.config.ts",
    "check:css": "node scripts/check-css.mjs",
    "names:translate": "tsx scripts/names-translate.ts",
    "names:same": "tsx scripts/names-same.ts",
    "i18n:missing": "tsx scripts/i18n-missing.ts"
  },
  "dependencies": {
    "@pnfo/pali-converter": "github:pnfo/pali-converter#90ae03ecb28d1c2585c8d58e21dfde5625b35834",
    "@unhead/vue": "^2.0.0",
    "@vueuse/core": "^13.0.0",
    "dompurify": "^3.2.0",
    "leaflet": "^1.9.4",
    "pinia": "^3.0.0",
    "reka-ui": "^2.5.0",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.0",
    "@iconify-json/mdi": "^1.2.3",
    "@juggle/resize-observer": "^3.4.0",
    "@playwright/test": "^1.55.0",
    "@types/better-sqlite3": "^7.6.0",
    "@types/leaflet": "^1.9.12",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-legacy": "^8.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/test-utils": "^2.4.0",
    "autoprefixer": "^10.4.0",
    "better-sqlite3": "^12.0.0",
    "doiuse": "^6.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-vue": "^10.0.0",
    "intersection-observer": "^0.12.2",
    "jsdom": "^27.0.0",
    "marked": "^18.1.1",
    "postcss": "^8.5.0",
    "postcss-preset-env": "^10.0.0",
    "tailwindcss": "^3.4.19",
    "terser": "^5.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "unplugin-icons": "^22.0.0",
    "vite": "^8.0.0",
    "vitest": "^4.0.0",
    "vue-tsc": "^3.0.0"
  },
  "allowScripts": {
    "better-sqlite3": true,
    "esbuild": true,
    "fsevents": true,
    "vue-demi": true,
    "core-js": false
  }
}
